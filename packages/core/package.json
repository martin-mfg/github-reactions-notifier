{
  "name": "@grn/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code adapted from github-stats-extended, kept app-agnostic so it can later be shared with it.",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "@grn/source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "generate-graphql-types": "node scripts/generate-graphql-types",
    "check-graphql-types": "node scripts/generate-graphql-types --check"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.1",
    "@graphql-codegen/typescript": "6.1.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@octokit/graphql-schema": "15.26.1",
    "@types/pg": "^8.23.1",
    "graphql": "16.14.2",
    "nock": "catalog:default",
    "vitest": "catalog:default"
  },
  "dependencies": {
    "axios": "catalog:default",
    "pg": "^8.23.1"
  }
}
