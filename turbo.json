{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "@grn/frontend#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/inbox-*.png"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
