---
/*
 * Replaces Starlight's `Banner`: every page shows that GRN is a prototype. A page that sets
 * its own `banner` in its frontmatter still gets it, below this one.
 */
import Default from "@astrojs/starlight/components/Banner.astro";
---

<div class="prototype-banner" data-pagefind-ignore>
  <strong>This is a prototype (alpha).</strong> It may have bugs or be shut down at any time. I'm releasing it early to find out whether people want it. <a href="https://github.com/martin-mfg/github-reactions-notifier#feedback">Your feedback</a> decides whether it gets developed further.
</div>
<Default />
