# Postgres connection string (see packages/core/sql/schema.sql for the schema)
POSTGRES_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Encrypts stored user tokens: 32 bytes, hex or base64 (`openssl rand -hex 32`).
# Comma-separate several keys to rotate; the first encrypts, all decrypt.
TOKEN_ENCRYPTION_KEY=
# The machine account that opens the inboxes and posts every comment; needs write access
# to issues in INBOX_REPO.
MACHINE_ACCOUNT_TOKEN=
# The repo holding the inbox issues, as owner/repo.
INBOX_REPO=
